PORT=5000
# Leave unset (defaults to 0.0.0.0) for local dev. In production behind
# Nginx, set HOST=127.0.0.1 so the Node process isn't directly reachable
# from outside the server.
HOST=0.0.0.0
MONGODB_URI=mongodb://localhost:27017/medmek
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRES_IN=7d
NODE_ENV=development

# Super Admin Credentials (seeded automatically on first run)
ADMIN_USERNAME=superadmin
ADMIN_EMAIL=admin@medmek.com
ADMIN_PASSWORD=Admin@123456
ADMIN_NAME=MedMek Admin

# Email (for forgot password OTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@email.com
SMTP_PASS=your_app_password
FROM_EMAIL=noreply@medmek.com

# Frontend URL for CORS
FRONTEND_URL=http://localhost:3000
